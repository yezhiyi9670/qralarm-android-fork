# Copy this file to keystore.properties (same directory) and fill in your own values.
# keystore.properties is git-ignored on purpose -- never commit real passwords.
#
# Release signing is optional: without keystore.properties the :app project still
# configures, the IDE syncs, and debug builds work; assembleRelease just produces an
# unsigned APK instead of failing.
#
# storeFile is resolved relative to the :app module directory, not the repository
# root, so a keystore kept next to settings.gradle.kts must be referenced as
# ../<name>.jks. Use forward slashes (or escape backslashes) -- this is a
# java.util.Properties file, where '\' is an escape character.
#
# Typical release values:
#   keyAlias=upload
#   keyPassword=********
#   storeFile=../qralarm-keystore.jks
#   storePassword=********
#
# For local experiments you may sign with the Android debug keystore instead:
#   keyAlias=androiddebugkey
#   keyPassword=android
#   storeFile=C:/Users/<you>/.android/debug.keystore
#   storePassword=android

keyAlias=your-key-alias
keyPassword=your-key-password
storeFile=../qralarm-keystore.jks
storePassword=your-store-password
